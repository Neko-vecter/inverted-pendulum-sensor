menu "Pendulum sensor"

config SENSOR_ESPNOW
    bool "Use ESP-NOW instead of Wi-Fi / UDP"
    default y
    help
        Send samples through an ESP-NOW USB gateway. The AP connection,
        reconnection task, IP configuration and UDP code are excluded.
        The Wi-Fi radio driver is still required by ESP-NOW.

config SENSOR_ESPNOW_CHANNEL
    int "ESP-NOW radio channel"
    depends on SENSOR_ESPNOW
    range 1 11
    default 1
    help
        Must match the gateway channel. No access point is required.

if !SENSOR_ESPNOW

config SENSOR_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        Wi-Fi network used by the sensor node. Leave empty to run sampling
        without starting the network.

config SENSOR_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        WPA2 passphrase for the configured network (8-63 bytes), or a 64-digit
        hexadecimal pre-shared key. An empty password selects an open network.

config SENSOR_SERVER_IPV4
    string "UDP server IPv4 address"
    default "192.168.1.100"

config SENSOR_SERVER_PORT
    int "UDP server port"
    range 1 65535
    default 5000

endif

endmenu
