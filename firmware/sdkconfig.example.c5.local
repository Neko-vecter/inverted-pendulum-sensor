# Local overrides for ESP-IDF and project-specific settings.
# Copy to sdkconfig.c5.local, then edit the values for this machine.
# Match the XIAO ESP32-C5 board's 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SENSOR_WIFI_SSID=""
CONFIG_SENSOR_WIFI_PASSWORD=""
CONFIG_SENSOR_SERVER_IPV4="192.168.1.100"
CONFIG_SENSOR_SERVER_PORT=5000
