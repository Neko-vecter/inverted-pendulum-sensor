menu "ESP-NOW gateway"

config GATEWAY_ESPNOW_CHANNEL
    int "ESP-NOW radio channel"
    range 1 11
    default 1

choice GATEWAY_SERIAL_INTERFACE
    prompt "Host serial interface"
    default GATEWAY_SERIAL_USB

config GATEWAY_SERIAL_USB
    bool "Native USB Serial/JTAG (XIAO ESP32-C6 USB port)"

config GATEWAY_SERIAL_UART
    bool "UART1 (external USB-UART adapter)"

endchoice

if GATEWAY_SERIAL_UART
config GATEWAY_UART_TX_GPIO
    int "UART1 TX GPIO"
    range 0 30
    default 16

config GATEWAY_UART_RX_GPIO
    int "UART1 RX GPIO"
    range 0 30
    default 17

config GATEWAY_UART_BAUD
    int "UART1 baud rate"
    range 115200 3000000
    default 921600
endif

endmenu
